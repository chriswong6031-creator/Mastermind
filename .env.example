# Copy to .env (gitignored) and fill in. Loaded automatically by `import bot`.
# Claude Code subscription token — mint with: claude setup-token
# This is the LEGACY bare token; prefer the numbered pool below when multiple accounts available.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# 'cli' = Claude Code subscription (default); 'api' = metered Messages API (needs ANTHROPIC_API_KEY)
BOT_LLM_BACKEND=cli
# --- OAuth key pool (rotation failover) ---
# Numbered OAuth token slots 1..7. Slots 3..7 are the primary pool; 1..2 legacy fallback.
# Add tokens from additional Claude accounts/subscriptions for automatic failover.
# The rotation layer (brain/key_rotor.py) picks the first non-cooling key automatically.
# CLAUDE_CODE_OAUTH_TOKEN_3=sk-ant-oat01-...
# CLAUDE_CODE_OAUTH_TOKEN_4=sk-ant-oat01-...
# CLAUDE_CODE_OAUTH_TOKEN_5=sk-ant-oat01-...
# CLAUDE_CODE_OAUTH_TOKEN_6=sk-ant-oat01-...
# CLAUDE_CODE_OAUTH_TOKEN_7=sk-ant-oat01-...
# Which slots are eligible (csv of slot numbers and/or "legacy"). Absent = all enabled.
# Example: METAB_KEYS_ENABLED=3,4,5
METAB_KEYS_ENABLED=
# --- Auth ---
# The browser password-cookie LOGIN flow was REMOVED (page-only scope): there is no
# /login page and reads are always open. Mutating/LLM-triggering POSTs are still
# gated by the bearer OPERATOR tier below, and MASTERMIND_SERVE_ONLY still blocks
# operator mutations on the internet-facing read mirror.
# Bearer token for the OPERATOR tier + non-browser clients (snapshot push / uptime
# ping). Required to fire mutating/LLM POSTs; unset = operator paths open (dev only).
#   Authorization: Bearer <token>
MASTERMIND_AUTH_TOKEN=
# Serve-only (read-only mirror) mode: =1 blocks operator mutations + never starts the
# scheduler. Set on the internet-facing VPS mirror; leave unset on the primary.
# MASTERMIND_SERVE_ONLY=1
