# Copy to .env (gitignored) and fill in. Loaded automatically by `import bot`.
# Claude Code subscription token — mint with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# 'cli' = Claude Code subscription (default); 'api' = metered Messages API (needs ANTHROPIC_API_KEY)
BOT_LLM_BACKEND=cli
# --- Auth (REQUIRED before exposing the server on any non-localhost address) ---
# Set a password to gate the whole app (UI + every /api route + the SSE stream).
# Unset = auth DISABLED (fine for localhost-only dev; never for a public address).
MASTERMIND_PASSWORD=
# Optional bearer token for non-browser clients (snapshot push / uptime ping):
#   Authorization: Bearer <token>
MASTERMIND_AUTH_TOKEN=
# Optional: session cookie lifetime in days (default 30); force Secure cookie (=1)
# when terminating TLS upstream even though the app sees http.
# MASTERMIND_SESSION_DAYS=30
# MASTERMIND_COOKIE_SECURE=1
