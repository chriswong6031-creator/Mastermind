__pycache__/
*.pyc
.venv/
.env
.DS_Store
.pytest_cache/
# local Phase 0 uses a symlink here; production replaces it with a real submodule
vendor/macro
# local data the bot writes (the published copy lives in the macro repo's site/)
data/portfolio/*.json
data/portfolio/*.jsonl
data/brain/*.jsonl
data/brain/*.json
data/brain/runs/
data/signal_archive/*.parquet
data/*.db
# SQLite write-ahead and journal sidecar files (safe to ignore; the DB itself is tracked above)
*.db-journal
*.db-wal
*.db-shm
# Dev-REPL artifact: when store._DB path resolves to a literal '{_DB}' string (e.g. the variable
# was never substituted), Python creates a file with that exact name at the repo root. The code is
# correct; this gitignore entry is belt-and-braces to keep the stray file out of commits.
{_DB}
data/research/
data/brain/proposals.jsonl
jobs/
!data/**/.gitkeep
data/*.sqlite
.env.local

# dedicated build-managed macro data checkout (kept fresh by data_layer/macro_refresh)
vendor/macro_src/

# runtime state written by live jobs / tests (never commit)
data/marks/
data/benchmark/
data/journal/
data/agenda/
data/self_tune/
data/market_view/
data/anticipation/
data/posture/
data/deploy_lag.json
catboost_info/
data/portfolio_watch/

# Session-local configuration, archives, and credential-bearing backups.
.claude/launch.json
.claude/worktree-backup-*/
.env.bak*
.worktrees/

# VPS-authoritative runtime output. Source/config fixtures that are already
# tracked remain tracked; these rules prevent new live state from entering PRs.
data/_backup*/
data/backtest/
data/brain/attribution/
data/brain/chat_history/
data/brain/cio/
data/brain/cost/
data/brain/decision_provenance/
data/brain/distill/
data/brain/student/
data/cache/
data/committee/
data/decision_context/
data/gate_officer/
data/lifecycle/
data/macro_risk/
data/mastermind/
data/mastermind_ai/
data/metabolism/
data/nw_reflection/
data/pipeline/
data/portfolio/_backup*/
data/portfolio/self_directed/
data/portfolios/
data/quiver/
data/response_logs/
data/risk_officer/
data/shadow/
data/signal_history/
data/universe_triage/
data/*.log
